# Public site origin used for metadata, canonical URLs, sitemap, and robots.
NEXT_PUBLIC_SITE_URL="https://your-site-domain.example"

# Optional URL for the main website.
NEXT_PUBLIC_MAIN_WEBSITE_URL="https://your-main-website.example/watch"

# Optional Google Analytics 4 Measurement ID (for example: G-ABC123DEF4).
GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# TMDB v3 API key OR API Read Access Token. Keep secret; do not use NEXT_PUBLIC_ prefix.
TMDB_API_KEY="your-tmdb-api-key"
# TMDB_ACCESS_TOKEN="your-tmdb-api-read-access-token"

# Optional catalog import settings.
TMDB_IMPORT_LIMIT="20"
TMDB_LANGUAGE="en-US"
