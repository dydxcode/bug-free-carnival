# Public site origin used for metadata, canonical URLs, sitemap, and robots.
NEXT_PUBLIC_SITE_URL="https://your-landing-domain.example"

# Optional URL for the main website. When unset, outbound watch links are shown as unavailable.
NEXT_PUBLIC_MAIN_WEBSITE_URL="https://your-main-website.example/watch"

# Optional Google Analytics 4 Measurement ID (for example: G-ABC123DEF4).
GA_MEASUREMENT_ID="G-XXXXXXXXXX"
